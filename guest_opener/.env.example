# Local development only (npm run dev). In Home Assistant the add-on options are used instead.
# Copy to .env and adjust.

PROPERTY_NAME=Ferienwohnung
PUBLIC_URL=
TIMEZONE=Europe/Berlin
# Example coordinates. Replace them with the front door.
PROPERTY_LAT=48.0
PROPERTY_LON=11.0
# 0 disables the location check (handy when testing from your desk)
GEOFENCE_RADIUS_M=0
HOST_PHONE=+49 170 0000000
# at least 12 characters
ADMIN_PASSWORD=lokal-test-1234
# Optional: push alerts via a Home Assistant notify service (needs HA_URL / HA_TOKEN)
NOTIFY_SERVICE=

# "mock" simulates the doors. To drive real devices, enter entity ids and an HA connection:
DOOR_HOUSE=mock
DOOR_HOUSE_BATTERY=
DOOR_APARTMENT=mock
DOOR_APARTMENT_BATTERY=
DOOR_APARTMENT_UNLOCK_ONLY=false
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=<long-lived access token from your HA user profile>

# SQLite database and generated session secret live here
DATA_DIR=.data
