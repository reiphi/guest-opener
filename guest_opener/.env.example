# Local development only (npm run dev). In Home Assistant the add-on options are used instead.
# Copy to .env and adjust.

PROPERTY_NAME=Ferienwohnung
PUBLIC_URL=
TIMEZONE=Europe/Berlin
# Example coordinates. Replace them with the front door.
PROPERTY_LAT=48.0
PROPERTY_LON=11.0
# 0 disables the location check (handy when testing from your desk)
GEOFENCE_RADIUS_M=0
HOST_PHONE=+49 170 0000000
# at least 12 characters
ADMIN_PASSWORD=lokal-test-1234
# Optional: push alerts via a Home Assistant notify service (needs HA_URL / HA_TOKEN)
NOTIFY_SERVICE=

# "off" hides a door, "mock" simulates it. Otherwise a Home Assistant entity id.
# Mode: open (buzzer, button, switch, script), open_and_lock (unlatch + lock), unlock_and_lock (unlock + lock).
DOOR_HOUSE=mock
DOOR_HOUSE_NAME=Haustür
DOOR_HOUSE_MODE=open
DOOR_HOUSE_BATTERY=
DOOR_APARTMENT=mock
DOOR_APARTMENT_NAME=Wohnungstür
DOOR_APARTMENT_MODE=open_and_lock
DOOR_APARTMENT_BATTERY=
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=<long-lived access token from your HA user profile>

# SQLite database and generated session secret live here
DATA_DIR=.data
